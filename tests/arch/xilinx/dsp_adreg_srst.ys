read_verilog <<EOT
module adreg_srst(input clk, rst, input signed [3:0] a, d, input signed [4:0] b, output reg signed [9:0] p);
reg signed [4:0] s;
always @(posedge clk) begin
	if (rst)
		s <= 0;
	else
		s <= a + d;
	p <= s * b;
end
endmodule

module adreg_srst_dreg_plain(input clk, rst, input signed [3:0] a, d, input signed [4:0] b, output reg signed [9:0] p);
reg signed [3:0] d_r;
reg signed [4:0] s;
always @(posedge clk) begin
	d_r <= d;
	if (rst)
		s <= 0;
	else
		s <= a + d_r;
	p <= s * b;
end
endmodule

module adreg_plain_dreg_srst(input clk, rst, input signed [3:0] a, d, input signed [4:0] b, output reg signed [9:0] p);
reg signed [3:0] d_r;
reg signed [4:0] s;
always @(posedge clk) begin
	if (rst)
		d_r <= 0;
	else
		d_r <= d;
	s <= a + d_r;
	p <= s * b;
end
endmodule

module adreg_dreg_srst(input clk, rst, input signed [3:0] a, d, input signed [4:0] b, output reg signed [9:0] p);
reg signed [3:0] d_r;
reg signed [4:0] s;
always @(posedge clk) begin
	if (rst) begin
		d_r <= 0;
		s <= 0;
	end else begin
		d_r <= d;
		s <= a + d_r;
	end
	p <= s * b;
end
endmodule
EOT
design -save read

hierarchy -top adreg_srst
proc
equiv_opt -assert -map +/xilinx/cells_sim.v synth_xilinx -noiopad
design -load postopt
cd adreg_srst
select -assert-count 1 t:DSP48E1
select -assert-count 1 t:DSP48E1 r:ADREG=1 %i
select -assert-count 1 t:DSP48E1 r:USE_DPORT=TRUE %i
select -assert-count 1 t:DSP48E1 %x:+DSP48E1[RSTD] w:rst %i

design -load read
hierarchy -top adreg_srst_dreg_plain
proc
equiv_opt -assert -map +/xilinx/cells_sim.v synth_xilinx -noiopad
design -load postopt
cd adreg_srst_dreg_plain
select -assert-count 1 t:DSP48E1
select -assert-count 1 t:DSP48E1 r:ADREG=1 %i
select -assert-count 1 t:DSP48E1 r:USE_DPORT=TRUE %i
select -assert-none t:DSP48E1 r:DREG=1 %i
select -assert-count 1 t:DSP48E1 %x:+DSP48E1[RSTD] w:rst %i

design -load read
hierarchy -top adreg_plain_dreg_srst
proc
equiv_opt -assert -map +/xilinx/cells_sim.v synth_xilinx -noiopad
design -load postopt
cd adreg_plain_dreg_srst
select -assert-count 1 t:DSP48E1
select -assert-count 1 t:DSP48E1 r:ADREG=1 %i
select -assert-count 1 t:DSP48E1 r:USE_DPORT=TRUE %i
select -assert-none t:DSP48E1 r:DREG=1 %i
select -assert-none t:DSP48E1 %x:+DSP48E1[RSTD] w:rst %i

design -load read
hierarchy -top adreg_dreg_srst
proc
equiv_opt -assert -map +/xilinx/cells_sim.v synth_xilinx -noiopad
design -load postopt
cd adreg_dreg_srst
select -assert-count 1 t:DSP48E1
select -assert-count 1 t:DSP48E1 r:ADREG=1 %i
select -assert-count 1 t:DSP48E1 r:USE_DPORT=TRUE %i
select -assert-count 1 t:DSP48E1 r:DREG=1 %i
select -assert-count 1 t:DSP48E1 %x:+DSP48E1[RSTD] w:rst %i
