logger -expect warning "Attribute .Async_Reg. is not recognised as ASYNC_REG" 1
read_verilog <<EOT
module sync3(input clk, a, output q);
(* ASYNC_REG = "TRUE" *) reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module sync3_lower(input clk, a, output q);
(* async_reg = "true" *) reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module chain3(input clk, a, output q);
reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module chain3_false(input clk, a, output q);
(* ASYNC_REG = "FALSE" *) reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module sync_pair(input clk, a, output q0, q1);
(* ASYNC_REG = "TRUE" *) reg [1:0] s0 = 2'b00;
(* ASYNC_REG = "TRUE" *) reg [1:0] s1 = 2'b00;
always @(posedge clk) begin
	s0 <= {s0[0], a};
	s1 <= {s1[0], a};
end
assign q0 = s0[1];
assign q1 = s1[1];
endmodule

module plain_pair(input clk, a, output q0, q1);
reg [1:0] s0 = 2'b00;
reg [1:0] s1 = 2'b00;
always @(posedge clk) begin
	s0 <= {s0[0], a};
	s1 <= {s1[0], a};
end
assign q0 = s0[1];
assign q1 = s1[1];
endmodule

module mixed(input clk, a, b, output q, r);
(* ASYNC_REG = "TRUE" *) reg [2:0] s = 3'b000;
reg [2:0] t = 3'b000;
always @(posedge clk) {s, t} <= {s[1:0], a, t[1:0], b};
assign q = s[2];
assign r = t[2];
endmodule

module sync_var(input clk, a, input [1:0] sel, output q);
(* ASYNC_REG = "TRUE" *) reg [3:0] s = 4'b0000;
always @(posedge clk) s <= {s[2:0], a};
assign q = s[sel];
endmodule

module dsp_in(input clk, input [15:0] a, b, output reg [31:0] p);
(* ASYNC_REG = "TRUE" *) reg [15:0] a_r;
always @(posedge clk) begin
	a_r <= a;
	p <= a_r * b;
end
endmodule

module ram_addr(input clk, we, input [3:0] wa, ra, input [7:0] wd, output [7:0] rd);
reg [7:0] mem [0:15];
(* ASYNC_REG = "TRUE" *) reg [3:0] ra_r;
always @(posedge clk) begin
	if (we) mem[wa] <= wd;
	ra_r <= ra;
end
assign rd = mem[ra_r];
endmodule
EOT
design -save read

design -load read
synth_xilinx -noiopad -noclkbuf -top sync3
select -assert-count 3 t:FDRE
select -assert-count 3 t:FDRE a:ASYNC_REG %i
select -assert-none t:SRL16E t:SRLC32E

design -load read
synth_xilinx -noiopad -noclkbuf -abc9 -top sync3
select -assert-count 3 t:FDRE
select -assert-count 3 t:FDRE a:ASYNC_REG %i
select -assert-none t:SRL16E t:SRLC32E

design -load read
synth_xilinx -noiopad -noclkbuf -dff -top sync3
select -assert-count 3 t:FDRE
select -assert-count 3 t:FDRE a:ASYNC_REG %i
select -assert-none t:SRL16E t:SRLC32E

design -load read
synth_xilinx -noiopad -noclkbuf -abc9 -dff -top sync3
select -assert-count 3 t:FDRE
select -assert-count 3 t:FDRE a:ASYNC_REG %i
select -assert-none t:SRL16E t:SRLC32E

design -load read
synth_xilinx -noiopad -noclkbuf -top sync3_lower
select -assert-count 3 t:FDRE
select -assert-none t:SRL16E t:SRLC32E

design -load read
synth_xilinx -noiopad -noclkbuf -top chain3
select -assert-count 1 t:SRL16E
select -assert-none t:FDRE

design -load read
synth_xilinx -noiopad -noclkbuf -abc9 -top chain3
select -assert-count 1 t:SRL16E
select -assert-none t:FDRE

design -load read
synth_xilinx -noiopad -noclkbuf -top chain3_false
select -assert-count 1 t:SRL16E
select -assert-none t:FDRE

design -load read
synth_xilinx -noiopad -noclkbuf -top sync_pair
select -assert-count 4 t:FDRE
select -assert-count 4 t:FDRE a:ASYNC_REG %i

design -load read
synth_xilinx -noiopad -noclkbuf -abc9 -top sync_pair
select -assert-count 4 t:FDRE
select -assert-count 4 t:FDRE a:ASYNC_REG %i

design -load read
synth_xilinx -noiopad -noclkbuf -top plain_pair
select -assert-count 2 t:FDRE

design -load read
synth_xilinx -noiopad -noclkbuf -top mixed
select -assert-count 3 t:FDRE
select -assert-count 3 t:FDRE a:ASYNC_REG %i
select -assert-count 1 t:SRL16E

design -load read
synth_xilinx -noiopad -noclkbuf -top sync_var
select -assert-count 4 t:FDRE
select -assert-none t:SRL16E t:SRLC32E

design -load read
synth_xilinx -noiopad -noclkbuf -top dsp_in
select -assert-count 1 t:DSP48E1
select -assert-count 16 t:FDRE a:ASYNC_REG %i

design -load read
synth_xilinx -noiopad -noclkbuf -top ram_addr
select -assert-count 4 t:FDRE a:ASYNC_REG %i

design -load read
hierarchy -top chain3
proc
opt_clean
select -assert-none t:$dff a:ASYNC_REG %i
design -load read
hierarchy -top sync3
proc
select -assert-count 1 t:$dff a:ASYNC_REG %i
design -load read
hierarchy -top mixed
proc
select -assert-count 2 t:$dff
select -assert-count 1 t:$dff a:ASYNC_REG %i

design -load read
synth_xilinx -noiopad -noclkbuf -dff -top sync_pair
select -assert-count 4 t:FDRE
select -assert-count 4 t:FDRE a:ASYNC_REG %i

design -load read
synth_xilinx -noiopad -noclkbuf -abc9 -dff -top sync_pair
select -assert-count 4 t:FDRE
select -assert-count 4 t:FDRE a:ASYNC_REG %i

design -load read
hierarchy -top sync_pair
proc
equiv_opt -async2sync -assert -map +/xilinx/cells_sim.v synth_xilinx -noiopad -noclkbuf -abc9 -dff

design -load read
hierarchy -top mixed
proc
equiv_opt -async2sync -assert -map +/xilinx/cells_sim.v synth_xilinx -noiopad -noclkbuf

design -load read
synth_xilinx -noiopad -noclkbuf -top sync_pair
opt_merge -share_all
select -assert-count 4 t:FDRE
select -assert-count 4 t:FDRE a:ASYNC_REG %i

design -reset
read_verilog <<EOT
module sync3_bare(input clk, a, output q);
(* ASYNC_REG *) reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module sync3_one(input clk, a, output q);
(* ASYNC_REG = 1 *) reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module chain3_zero(input clk, a, output q);
(* ASYNC_REG = 0 *) reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module chain3_no(input clk, a, output q);
(* ASYNC_REG = "no" *) reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module chain3_mixedcase(input clk, a, output q);
(* Async_Reg = "TRUE" *) reg [2:0] s = 3'b000;
always @(posedge clk) s <= {s[1:0], a};
assign q = s[2];
endmodule

module plain3_then_sync1(input clk, a, output q);
reg [2:0] p = 3'b000;
(* ASYNC_REG = "TRUE" *) reg s = 1'b0;
always @(posedge clk) begin
	p <= {p[1:0], a};
	s <= p[2];
end
assign q = s;
endmodule

module sync1_then_plain3(input clk, a, output q);
(* ASYNC_REG = "TRUE" *) reg s = 1'b0;
reg [2:0] p = 3'b000;
always @(posedge clk) begin
	s <= a;
	p <= {p[1:0], s};
end
assign q = p[2];
endmodule

module plain_into_sync(input clk, a, b, output q);
reg p = 1'b0;
(* ASYNC_REG = "TRUE" *) reg [1:0] s = 2'b00;
always @(posedge clk) begin
	p <= a ^ b;
	s <= {s[0], p};
end
assign q = s[1];
endmodule

module two_domain(input clk_a, clk_b, a, b, c, output q, r);
reg [1:0] x = 2'b00;
always @(posedge clk_a) x <= {x[0] ^ b, a & c};
assign r = x[1];
(* ASYNC_REG = "TRUE" *) reg [1:0] s = 2'b00;
always @(posedge clk_b) s <= {s[0], x[1]};
assign q = s[1];
endmodule
EOT
logger -check-expected
design -save read2

design -load read
synth_xilinx -noiopad -noclkbuf -top sync3_lower
select -assert-count 3 t:FDRE a:ASYNC_REG %i
select -assert-none t:FDRE a:async_reg %i

design -load read2
synth_xilinx -noiopad -noclkbuf -top sync3_bare
select -assert-count 3 t:FDRE a:ASYNC_REG %i
select -assert-none t:SRL16E t:SRLC32E

design -load read2
synth_xilinx -noiopad -noclkbuf -top sync3_one
select -assert-count 3 t:FDRE a:ASYNC_REG %i
select -assert-none t:SRL16E t:SRLC32E

design -load read2
synth_xilinx -noiopad -noclkbuf -top chain3_zero
select -assert-count 1 t:SRL16E
select -assert-none t:FDRE

design -load read2
synth_xilinx -noiopad -noclkbuf -top chain3_no
select -assert-count 1 t:SRL16E
select -assert-none t:FDRE

design -load read2
synth_xilinx -noiopad -noclkbuf -top chain3_mixedcase
select -assert-count 1 t:SRL16E
select -assert-none t:FDRE

design -load read2
synth_xilinx -noiopad -noclkbuf -top plain3_then_sync1
select -assert-count 1 t:SRL16E
select -assert-count 1 t:FDRE
select -assert-count 1 t:FDRE a:ASYNC_REG %i

design -load read2
synth_xilinx -noiopad -noclkbuf -top sync1_then_plain3
select -assert-count 1 t:SRL16E
select -assert-count 1 t:FDRE
select -assert-count 1 t:FDRE a:ASYNC_REG %i

design -load read
hierarchy -top sync3
proc
techmap
abc -dff -clk clk
select -assert-count 3 t:$_DFF_P_
select -assert-count 3 t:$_DFF_P_ a:ASYNC_REG %i

design -load read
hierarchy -top sync_pair
proc
techmap
abc -dff -clk clk
opt_merge
select -assert-count 4 t:$_DFF_P_ a:ASYNC_REG %i

design -load read2
hierarchy -top plain_into_sync
proc
techmap
abc -dff
select -assert-count 3 t:$_DFF_P_
select -assert-count 2 t:$_DFF_P_ a:ASYNC_REG %i

design -load read2
hierarchy -top two_domain
proc
techmap
logger -expect log "[0-9] cells in clk=" 1
logger -expect log "[0-9] cells in clk=\\clk_a" 1
abc -dff
logger -check-expected
select -assert-count 2 t:$_DFF_P_ a:ASYNC_REG %i

design -reset
logger -expect warning "Attribute .aSYNC_REG. is not recognised as ASYNC_REG" 1
logger -expect warning "Attribute .Async_reg. is not recognised as ASYNC_REG" 1
read_verilog <<EOT
module hand_fdre(input clk, a, output q);
wire m0, m1;
(* aSYNC_REG = "TRUE" *) FDRE f0 (.C(clk), .CE(1'b1), .R(1'b0), .D(a), .Q(m0));
(* ASYNC_REG = "TRUE" *) FDRE f1 (.C(clk), .CE(1'b1), .R(1'b0), .D(m0), .Q(m1));
(* async_reg = "TRUE", Async_reg *) FDRE f2 (.C(clk), .CE(1'b1), .R(1'b0), .D(m1), .Q(q));
endmodule
EOT
logger -check-expected
